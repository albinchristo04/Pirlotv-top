---
// src/pages/partido/[slug].astro
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import TimezoneRow from '../../components/TimezoneRow.astro';
import MatchCard from '../../components/MatchCard.astro';
import { getMatches } from '../../lib/data';
import { matchSeo, sportsEventSchema, faqMatchSchema, breadcrumbSchema } from '../../lib/seo';
import { SITE_URL } from '../../lib/config';

export async function getStaticPaths() {
  const matches = await getMatches();
  return matches.map((m) => ({
    params: { slug: m.slug },
    props: { match: m },
  }));
}

const { match: m } = Astro.props;
const allMatches = await getMatches();
const related = allMatches
  .filter((r) => r.slug !== m.slug && (r.leagueSlug === m.leagueSlug || r.sportSlug === m.sportSlug))
  .slice(0, 6);

const seo = matchSeo(m);
const schema = [
  sportsEventSchema(m),
  faqMatchSchema(m),
  breadcrumbSchema([
    { name: m.sportLabel, url: `${SITE_URL}/${m.sportSlug}/` },
    { name: m.league, url: `${SITE_URL}/${m.leagueSlug}/` },
    { name: `${m.team1} vs ${m.team2}`, url: seo.canonical },
  ]),
];

const faqItems = [
  {
    q: `¿Dónde mirar ${m.team1} contra ${m.team2}?`,
    a: `Ver ${m.team1} vs ${m.team2} en vivo gratis en Pirlo TV (pirlo-tv.top). El partido comienza a las ${m.time} UTC. Disponible en ${m.channels.length} canales.`,
  },
  {
    q: `¿A qué hora juega ${m.team1} hoy?`,
    a: `${m.team1} juega a las ${m.timezones} contra ${m.team2} por ${m.league}.`,
  },
  {
    q: `¿En qué canal se transmite ${m.team1} vs ${m.team2}?`,
    a: `El partido se transmite con ${m.channels.length} canales disponibles y 4 servidores en Pirlo TV. Ver gratis sin registro.`,
  },
];
---
<Base seo={seo} schema={schema}>
  <div class="player-page">
    <Breadcrumb items={[
      { label: m.sportLabel, href: `/${m.sportSlug}/` },
      { label: m.league, href: `/${m.leagueSlug}/` },
      { label: `${m.team1} vs ${m.team2}` },
    ]} />

    <div class="match-header">
      <div class="match-header__league">{m.league}</div>
      <h1 class="match-header__h1">{m.team1} vs {m.team2} en Vivo</h1>
      <div class="match-header__date">{m.dateLabel} · {m.time} UTC</div>
    </div>

    <a
      href="https://ppvtv.top"
      target="_blank"
      rel="noopener nofollow"
      class="ppvtv-banner"
      aria-label="Visita PPVTV.TOP para más deportes en vivo"
    >
      <span class="ppvtv-banner__badge">EN VIVO</span>
      <span class="ppvtv-banner__text">
        ¿Buscas más deportes en directo? Míralos gratis en <strong>PPVTV.TOP</strong>
      </span>
      <span class="ppvtv-banner__cta">Ver ahora →</span>
    </a>

    <a
      href="https://t.me/+y_uO-8SzlVY4NGVl"
      target="_blank"
      rel="noopener nofollow"
      class="alert-banner alert-banner--tg"
      aria-label="Únete a nuestro canal de Telegram"
    >
      <span class="alert-banner__icon">📲</span>
      <span class="alert-banner__text">
        Únete a nuestro <strong>Telegram</strong> para enlaces y actualizaciones en vivo
      </span>
      <span class="alert-banner__cta">Unirme →</span>
    </a>

    <a
      href="https://ppvtv.top"
      target="_blank"
      rel="noopener nofollow"
      class="alert-banner alert-banner--buffer"
      aria-label="¿Problemas de buffering? Mira aquí"
    >
      <span class="alert-banner__icon">⚠️</span>
      <span class="alert-banner__text">
        ¿Problemas de <strong>buffering</strong>? Haz clic aquí para una mejor transmisión
      </span>
      <span class="alert-banner__cta">Ver mejor →</span>
    </a>

    <div class="banner-ad" aria-hidden="true">
      <script is:inline>
        atOptions = {
          'key' : '11060a6408ed16670a2c0a8753b59dd8',
          'format' : 'iframe',
          'height' : 250,
          'width' : 300,
          'params' : {}
        };
      </script>
      <script is:inline src="https://comediandesired.com/11060a6408ed16670a2c0a8753b59dd8/invoke.js"></script>
    </div>

    <Player match={m} />
    <TimezoneRow timezones={m.timezones} />

    <p style="font-size:0.85rem;color:#7a7a9a;margin-bottom:1.5rem;">
      Ver {m.team1} vs {m.team2} en vivo por {m.league} en Pirlo TV.
      El partido comienza a las {m.timezones}.
      Disponible en {m.channels.length} canales con 4 servidores por canal.
      Transmisión gratis sin registro. También disponible en
      <a href="/tarjeta-roja/" style="color:var(--accent)">Tarjeta Roja TV</a> y
      <a href="/pirlo-tv/" style="color:var(--accent)">Pirlo TV</a>.
    </p>

    <FaqBlock items={faqItems} />

    {related.length > 0 && (
      <div class="related">
        <h2 class="section-title">Más Partidos Hoy</h2>
        <div class="related__grid">
          {related.map((r) => <MatchCard match={r} />)}
        </div>
      </div>
    )}
  </div>
  <script src="https://comediandesired.com/b8/10/cc/b810cc16cea2ba05cd8730a8521c874e.js"></script>
</Base>

<style>
  .ppvtv-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--accent);
    background: linear-gradient(135deg, rgba(230, 57, 70, 0.12), rgba(255, 107, 53, 0.12));
    text-decoration: none;
    color: var(--text);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .ppvtv-banner:hover {
    background: linear-gradient(135deg, rgba(230, 57, 70, 0.22), rgba(255, 107, 53, 0.22));
    transform: translateY(-1px);
  }
  .ppvtv-banner__badge {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }
  .ppvtv-banner__text {
    flex: 1 1 auto;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .ppvtv-banner__text strong {
    color: var(--accent2);
    font-weight: 800;
  }
  .ppvtv-banner__cta {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .ppvtv-banner__cta { display: none; }
  }

  .alert-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .alert-banner:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }
  .alert-banner__icon {
    flex-shrink: 0;
    font-size: 1.1rem;
    line-height: 1;
  }
  .alert-banner__text {
    flex: 1 1 auto;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .alert-banner__text strong { font-weight: 800; }
  .alert-banner__cta {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .alert-banner--tg {
    border: 1px solid #29a9eb;
    background: linear-gradient(135deg, rgba(41, 169, 235, 0.14), rgba(41, 169, 235, 0.06));
  }
  .alert-banner--tg .alert-banner__text strong,
  .alert-banner--tg .alert-banner__cta { color: #29a9eb; }
  .alert-banner--buffer {
    border: 1px solid #f0a500;
    background: linear-gradient(135deg, rgba(240, 165, 0, 0.16), rgba(240, 165, 0, 0.06));
  }
  .alert-banner--buffer .alert-banner__text strong,
  .alert-banner--buffer .alert-banner__cta { color: #f0a500; }
  @media (max-width: 520px) {
    .alert-banner__cta { display: none; }
  }

  .banner-ad {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 250px;
    margin-bottom: 1rem;
    overflow: hidden;
  }
</style>
