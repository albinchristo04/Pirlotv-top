---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import { getMatches } from '../lib/data';
import { homeSeo, websiteSchema, breadcrumbSchema } from '../lib/seo';
import { SITE_URL } from '../lib/config';

const matches = await getMatches();
const seo = homeSeo();
const buildTime = new Date().toLocaleString('es-ES', { timeZone: 'UTC', hour12: false });

const schema = [
  websiteSchema(),
  breadcrumbSchema([{ name: 'Pirlo TV', url: SITE_URL + '/' }]),
];
---
<Base seo={seo} schema={schema}>
  <section class="hero">
    <div class="hero__badges">
      <span class="badge badge--live">● En Vivo</span>
      <span class="badge">Pirlo TV</span>
      <span class="badge">Roja Directa</span>
      <span class="badge">Tarjeta Roja TV</span>
    </div>
    <h1 class="hero__title">
      <span>Pirlo TV</span> — Deportes en Vivo Gratis
    </h1>
    <p class="hero__sub">
      Ver {matches.length} partidos en vivo hoy gratis en Pirlo TV. Fútbol, MLB, NBA, MotoGP y más deportes
      en directo con múltiples canales en español de forma rápida y sencilla.
    </p>
    <p class="hero__ts">🔄 Actualizado: {buildTime} UTC</p>
  </section>

  <!-- SEO text block (visually subtle but highly crawlable for Bing SEO) -->
  <div style="font-size:0.85rem;color:#5c5c7a;margin-bottom:2rem;line-height:1.6;border-left:2px solid var(--accent);padding-left:0.75rem;">
    <strong>Pirlo TV en vivo gratis</strong> es el portal de referencia para ver deportes online. Accede a las transmisiones de 
    <strong>tarjeta roja futbol en vivo gratis pirlo</strong> y los streams oficiales de <strong>roja directa pirlo tv</strong>. 
    Disfruta de todos los partidos de fútbol, incluyendo la Liga MX, Copa Libertadores, Copa Sudamericana, Fútbol Argentino, Brasileirão y LaLiga. 
    También transmitimos <strong>pirlo tv motogp</strong> en directo, carreras de motos y <strong>pirlo tv nba hoy</strong> en vivo, 
    así como todo el béisbol en <strong>pirlo tv mlb</strong> hoy. Todo en pirlo-tv.top, tu alternativa estable a www.pirlotv.es gratis en directo.
  </div>

  <MatchList matches={matches} groupByLeague={true} />

  <!-- Competition Hub links -->
  <h2 class="section-title">🏆 Hub de Competiciones</h2>
  <p style="color:#7a7a9a;font-size:0.85rem;margin:-0.5rem 0 1.25rem;">
    Explora todas las ligas disponibles. Enfoque especial en fútbol de Latinoamérica y torneos mundiales.
  </p>
  <div class="match-grid" style="margin-bottom:1.5rem;">
    {[
      { href: '/liga-mx/',           label: '🇲🇽 Liga MX',            sub: 'Fútbol Mexicano en vivo gratis' },
      { href: '/copa-libertadores/', label: '🏆 Copa Libertadores',   sub: 'Copa Libertadores de América' },
      { href: '/futbol-argentino/',  label: '🇦🇷 Fútbol Argentino',   sub: 'Liga Profesional · Copa Argentina' },
      { href: '/brasileirao/',       label: '🇧🇷 Brasileirão',        sub: 'Serie A de Brasil en directo' },
      { href: '/liga-chilena/',      label: '🇨🇱 Liga Chilena',       sub: 'Campeonato Nacional chileno' },
      { href: '/laliga/',            label: '🇪🇸 LaLiga',             sub: 'Real Madrid y Barcelona hoy' },
      { href: '/nba/',               label: '🏀 NBA',                sub: 'Pirlo TV NBA en vivo hoy' },
      { href: '/mlb/',               label: '⚾ MLB',                sub: 'Béisbol de Grandes Ligas gratis' },
      { href: '/motogp/',            label: '🏍 MotoGP',              sub: 'Carreras y prácticas de MotoGP' },
    ].map((hub) => (
      <a href={hub.href} class="match-card" style="text-decoration:none;">
        <div class="match-card__teams" style="font-size:0.95rem;">{hub.label}</div>
        <div class="match-card__league">{hub.sub}</div>
        <div class="match-card__live" style="margin-top:0.25rem;">Ver partidos →</div>
      </a>
    ))}
  </div>
  
  <div style="text-align:center;margin-bottom:3rem;">
    <a href="/hub/" class="ctrl-btn active" style="padding:0.6rem 1.5rem;font-size:0.9rem;border-radius:30px;display:inline-block;text-decoration:none;">
      Ver Todas las Competiciones →
    </a>
  </div>

  <!-- Brand pages -->
  <h2 class="section-title">Accesos Directos</h2>
  <div class="match-grid">
    {[
      { href: '/pirlo-tv/',              label: '⚡ Pirlo TV',                sub: 'pirlotv · pirlo tv en vivo' },
      { href: '/tarjeta-roja/',          label: '🟥 Tarjeta Roja TV',         sub: 'tarjeta roja en vivo gratis' },
      { href: '/roja-directa-pirlo-tv/', label: '🔴 Roja Directa Pirlo TV',   sub: 'roja directa pirlo tv' },
    ].map((b) => (
      <a href={b.href} class="match-card" style="text-decoration:none;">
        <div class="match-card__teams" style="font-size:0.95rem;">{b.label}</div>
        <div class="match-card__league">{b.sub}</div>
        <div class="match-card__live" style="margin-top:0.25rem;">Acceder →</div>
      </a>
    ))}
  </div>
</Base>
